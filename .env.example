NEXT_PUBLIC_SOJ_API_MODE=mock
# Leave NEXT_PUBLIC_SOJ_API_BASE_URL unset in http mode to use the same-origin /soj-api proxy.
# NEXT_PUBLIC_SOJ_API_BASE_URL=http://localhost:8080
# SOJ_API_INTERNAL_BASE_URL=http://localhost:8080

# Production Compose defaults. The backend Compose project exposes its API as api:8080.
# NEXT_PUBLIC_SOJ_API_MODE=http
# NEXT_PUBLIC_SOJ_API_BASE_URL=/soj-api
# SOJ_API_INTERNAL_BASE_URL=http://api:8080
# SOJ_BACKEND_NETWORK=soj_default
# SOJ_WEB_PORT=3000
